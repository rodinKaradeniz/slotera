# Copy to deploy/.env on the server and fill in. Never commit the real file.

# Hosts (DNS A/AAAA records point at the server). The bare domain redirects to DEMO_HOST.
ROOT_HOST=slotera.io
DEMO_HOST=www.slotera.io
APP_HOST=app.slotera.io
API_HOST=api.slotera.io
ACME_EMAIL=slotera@merulio.com

# Image tag; set to the git commit when deploying so rollbacks can reuse old images
RELEASE=latest

# Database (generate long random values, e.g. `openssl rand -hex 32`)
POSTGRES_PASSWORD=
SLOTERA_APP_DB_PASSWORD=

# API
SLOTERA_CORS_ORIGINS=["https://app.slotera.io"]
SLOTERA_PUBLIC_WEB_BASE_URL=https://app.slotera.io
SLOTERA_CSRF_COOKIE_DOMAIN=.slotera.io
SLOTERA_EMAIL_PROVIDER=resend
# Must be on a domain verified in Resend
SLOTERA_EMAIL_FROM_ADDRESS=Slotera <no-reply@slotera.merulio.com>
SLOTERA_RESEND_API_KEY=
# Self-serve sign-up: false during the invite-only pilot (staff provision workspaces from
# pilot applications). Also compiled into the app image, so rebuild after changing it.
SLOTERA_SIGNUP_OPEN=false
# Shown in footers and the operator's help links
SUPPORT_EMAIL=slotera@merulio.com

# Error monitoring (Sentry, EU organisation; empty = off). See docs/DEPLOYMENT.md.
# API, email worker and maintenance job: the slotera-api project's DSN
SLOTERA_SENTRY_DSN=
# Real app (app.): the slotera-web project's DSN. The demo never reports.
SENTRY_WEB_DSN=
# Source map upload at build time: organisation slug, project slug, organisation token
SENTRY_ORG=
SENTRY_WEB_PROJECT=slotera-web
SENTRY_AUTH_TOKEN=

# Off-box backups: user@host of the Hetzner Storage Box (port 23). Put the SSH key in
# deploy/backup/ssh/id_ed25519 and add its public half to the Storage Box.
STORAGE_BOX=

# Set to 1 and run `up -d` to show the maintenance page (HTTP 503) on both web hosts
MAINTENANCE_MODE=0
