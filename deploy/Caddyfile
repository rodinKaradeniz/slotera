# Automatic HTTPS for the public hosts (set in deploy/.env).
{
	email {$ACME_EMAIL}
}

# Headers for every host. The Content-Security-Policy is sent by the web app itself, in
# report-only mode for now (docs/TODO.md).
(security) {
	header {
		# One year, without preload: preload is hard to undo.
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}

# The bare domain goes to the marketing site.
{$ROOT_HOST} {
	import security
	redir https://{$DEMO_HOST}{uri} permanent
}

{$DEMO_HOST} {
	import security
	encode zstd gzip
	reverse_proxy web-demo:3000
}

{$APP_HOST} {
	import security
	encode zstd gzip
	reverse_proxy web-app:3000
}

{$API_HOST} {
	import security
	header X-Robots-Tag "noindex"
	encode zstd gzip
	reverse_proxy api:8000
}
