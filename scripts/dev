#!/usr/bin/env bash

set -Eeuo pipefail

REPOSITORY_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SERVER_DIR="${REPOSITORY_DIR}/server"
WEB_DIR="${REPOSITORY_DIR}/web"
PREPARE_ONLY=false
API_MODE=false
NO_ENV=false
LOG_DIR="${REPOSITORY_DIR}/.logs"

usage() {
  cat <<'EOF'
Usage: ./scripts/dev [--api] [--no-env] [--prepare-only]

Prepare and run the complete local Slotera development stack. Each process
writes its output to .logs/ (api.log, worker.log, web.log) as well as the terminal.

  --api           Run the frontend against the local FastAPI backend. The
                  default remains the deterministic mock data source.
  --no-env        Run on the built-in local defaults: never create or read an env
                  file, and skip dependency installs. For agents and CI; the
                  developer's own runs use server/.env and web/.env.local.
  --prepare-only  Install dependencies, start PostgreSQL, migrate, and seed;
                  do not start the API or frontend processes.
  -h, --help      Show this help.
EOF
}

log() {
  printf '\n[slotera] %s\n' "$1"
}

fail() {
  printf '\n[slotera] error: %s\n' "$1" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || fail "required command not found: $1"
}

for argument in "$@"; do
  case "${argument}" in
    --prepare-only)
      PREPARE_ONLY=true
      ;;
    --api)
      API_MODE=true
      ;;
    --no-env)
      NO_ENV=true
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      fail "unknown argument: ${argument}"
      ;;
  esac
done

require_command docker
require_command npm
require_command uv
require_command python3

if [[ "${PREPARE_ONLY}" != true ]]; then
  python3 "${REPOSITORY_DIR}/scripts/dev-processes.py" --check-ports
fi

docker info >/dev/null 2>&1 || fail "Docker is not running"

COMPOSE_ENV_FILE=()
if [[ "${NO_ENV}" == true ]]; then
  # An empty value makes the backend skip its env file; compose skips its default one.
  export SLOTERA_ENV_FILE=""
  COMPOSE_ENV_FILE=(--env-file /dev/null)
  log "Running on built-in defaults: no env file is read, no dependencies are installed."
else
  if [[ ! -f "${SERVER_DIR}/.env" ]]; then
    cp "${SERVER_DIR}/env.example" "${SERVER_DIR}/.env"
    log "Created server/.env from server/env.example."
  fi

  if [[ ! -f "${WEB_DIR}/.env.local" ]]; then
    cp "${WEB_DIR}/env.example" "${WEB_DIR}/.env.local"
    log "Created web/.env.local from web/env.example."
  fi

  log "Synchronizing backend dependencies..."
  (
    cd "${SERVER_DIR}"
    uv sync --locked
  )

  log "Synchronizing frontend dependencies..."
  npm install --no-audit --no-fund --prefix "${WEB_DIR}"
fi

log "Generating frontend transport types from FastAPI OpenAPI..."
npm run generate:api --prefix "${WEB_DIR}"

log "Starting PostgreSQL and waiting for it to become healthy..."
docker compose --project-directory "${SERVER_DIR}" ${COMPOSE_ENV_FILE[@]+"${COMPOSE_ENV_FILE[@]}"} up -d --wait db

log "Applying pending Alembic migrations..."
(
  cd "${SERVER_DIR}"
  .venv/bin/alembic upgrade head
  .venv/bin/alembic current
)

# Revision 0002 inserts showcase data once. Ordinary restarts must preserve deletions,
# edits and dates; ./scripts/reset-db is the explicit way to restore the showcase.

if [[ "${PREPARE_ONLY}" == true ]]; then
  log "Local dependencies, database, migrations, and seed are ready."
  exit 0
fi

SUPERVISOR_ARGS=()
[[ "${API_MODE}" != true ]] || SUPERVISOR_ARGS+=(--api)
exec python3 "${REPOSITORY_DIR}/scripts/dev-processes.py" ${SUPERVISOR_ARGS[@]+"${SUPERVISOR_ARGS[@]}"}
