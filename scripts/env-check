#!/usr/bin/env python3
"""Report which env variables are set, without ever printing a value.

Run it in your own terminal, then paste the output to an agent when something looks
env-related. It compares each env file with its `env.example` (names only), then asks the
backend to validate its settings and prints only the field name and the rule that failed.

    ./scripts/env-check             server/.env and web/.env.local
    ./scripts/env-check --deploy    also deploy/.env (the production values)
"""

import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
if "--root" in sys.argv:  # test hook: check another checkout
    ROOT = Path(sys.argv[sys.argv.index("--root") + 1]).resolve()

FILES = [("server/.env", "server/env.example"), ("web/.env.local", "web/env.example")]
if "--deploy" in sys.argv:
    FILES.append(("deploy/.env", "deploy/env.example"))

VALIDATE = """
from pydantic import ValidationError
from slotera_api.config import MigrationSettings, Settings
for cls in (Settings, MigrationSettings):
    try:
        cls()
    except ValidationError as error:
        for item in error.errors():
            print(f"{cls.__name__}.{'.'.join(map(str, item['loc'])) or 'model'}: {item['msg']}")
"""


DEFAULTS = """
from slotera_api.config import MigrationSettings, Settings
for cls in (Settings, MigrationSettings):
    for name, field in cls.model_fields.items():
        if not field.is_required():
            print("SLOTERA_" + name.upper())
"""


def backend_defaults() -> set[str]:
    """Backend variables the code has a default for, so leaving them out is fine."""
    python = ROOT / "server/.venv/bin/python"
    if not python.exists():
        return set()
    result = subprocess.run(
        [str(python), "-c", DEFAULTS], cwd=ROOT / "server", capture_output=True, text=True
    )
    return set(result.stdout.split())


def names(path: Path) -> dict[str, bool]:
    """Variable name -> True when it has a non-empty value. Values are never kept."""
    found: dict[str, bool] = {}
    for line in path.read_text().splitlines():
        key, sep, value = line.strip().partition("=")
        if sep and key.isidentifier():
            found[key] = bool(value.strip().strip("\"'"))
    return found


def optional_names(path: Path) -> set[str]:
    """Names the example lists commented out, e.g. `# SLOTERA_SENTRY_DSN=`."""
    out = set()
    for line in path.read_text().splitlines():
        key, sep, _ = line.strip().lstrip("#").strip().partition("=")
        if line.strip().startswith("#") and sep and key.isidentifier():
            out.add(key)
    return out


defaults = backend_defaults()
problems = 0
for env_name, example_name in FILES:
    env, example = ROOT / env_name, ROOT / example_name
    print(f"\n{env_name}")
    if not env.exists():
        print("  MISSING FILE  copy it from the example, then fill it in")
        problems += 1
        continue
    if not example.exists():
        print(f"  no {example_name} to compare against")
        continue
    have, wanted, optional = names(env), names(example), optional_names(example)
    for key in sorted(set(wanted) | optional | set(have)):
        if key not in wanted and key not in optional:
            state = "unknown"
        elif key in have:
            state = "set" if have[key] else "empty"
        elif key in defaults:
            state = "default"
        elif key in wanted:
            state, problems = "MISSING", problems + 1
        else:
            state = "optional"
        note = "  (not in the example)" if state == "unknown" else ""
        print(f"  {state:<9} {key}{note}")

server = ROOT / "server"
if (server / ".env").exists() and (server / ".venv/bin/python").exists():
    print("\nbackend settings validation (server/.env)")
    result = subprocess.run(
        [str(server / ".venv/bin/python"), "-c", VALIDATE],
        cwd=server,
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        print("  could not load the settings; run `cd server && uv sync` first")
        problems += 1
    elif result.stdout.strip():
        for line in result.stdout.strip().splitlines():
            print(f"  FAILED    {line}")
            problems += 1
    else:
        print("  ok")

print(f"\n{problems} problem(s). Only names and statuses are shown; no values.")
sys.exit(1 if problems else 0)
