SLOTERA_ENVIRONMENT=local
SLOTERA_LOG_LEVEL=INFO
SLOTERA_DATABASE_URL=postgresql+asyncpg://slotera_app:slotera_app_local@localhost:55432/slotera
SLOTERA_MIGRATION_DATABASE_URL=postgresql+asyncpg://slotera_owner:slotera_owner_local@localhost:55432/slotera
SLOTERA_DEMO_SEED_PASSWORD=slotera-local-only
SLOTERA_CORS_ORIGINS='["http://localhost:3344"]'
# Production sibling origins also require SLOTERA_CSRF_COOKIE_DOMAIN=.slotera.app
