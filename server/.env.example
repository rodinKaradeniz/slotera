SLOTERA_ENVIRONMENT=local
SLOTERA_LOG_LEVEL=INFO
SLOTERA_DATABASE_URL=postgresql+asyncpg://slotera_app:slotera_app_local@localhost:55432/slotera
SLOTERA_MIGRATION_DATABASE_URL=postgresql+asyncpg://slotera_owner:slotera_owner_local@localhost:55432/slotera
SLOTERA_DEMO_SEED_PASSWORD=slotera-local-only
SLOTERA_CORS_ORIGINS='["http://localhost:3344"]'
SLOTERA_PUBLIC_WEB_BASE_URL=http://localhost:3344
SLOTERA_PASSWORD_RESET_TTL_MINUTES=60
SLOTERA_EMAIL_PROVIDER=console
# Must be on a domain verified in Resend (console provider: any value works).
SLOTERA_EMAIL_FROM_ADDRESS='Slotera <no-reply@slotera.merulio.com>'
# Production requires SLOTERA_EMAIL_PROVIDER=resend and SLOTERA_RESEND_API_KEY.
# Production sibling origins also require SLOTERA_CSRF_COOKIE_DOMAIN=.slotera.io
# Optional: report errors to Sentry (the slotera-api project DSN). Empty = off.
# SLOTERA_SENTRY_DSN=
